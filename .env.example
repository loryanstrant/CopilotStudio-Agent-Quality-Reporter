# ---- Database ----
DATABASE_URL=postgresql+psycopg://agentquality:agentquality@db:5432/agentquality
POSTGRES_USER=agentquality
POSTGRES_PASSWORD=agentquality
POSTGRES_DB=agentquality

# ---- Security ----
# Signs session/JWT tokens for the password gate. Change in production.
SECRET_KEY=dev-insecure-change-me
# Fernet key for encrypting stored secrets (Dataverse SP secret, Foundry key).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First-run admin bootstrap (only created when no app users exist yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- Entra sign-in (optional) ----
# The app runs the OpenID Connect sign-in itself, reusing the app registration
# saved on the Settings page — there is nothing to configure on the host.
# Set this only when a reverse proxy hides the real public address from the app
# (i.e. it doesn't send X-Forwarded-Proto / X-Forwarded-Host). It must match the
# redirect URI registered in Entra, e.g. https://aqp.contoso.com
PUBLIC_BASE_URL=

# ---- Host ports ----
# Only the host-side ports are configurable; change these if they clash with
# other stacks running on the same machine. Container-internal ports are
# unchanged, so DATABASE_URL and the api:8000 proxy target stay the same.
#
# Each solution in the suite owns a distinct block so all four run side by side:
#   Usage Reporter 5432/8000 | Cowork Reporter 5433/8001
#   Agent Quality  5434/8002 | Prompt Analyser 5435/8003
#
# In production the API serves the built SPA, so the dashboard is on API_PORT
# and WEB_PORT applies only to docker-compose.dev.yml (the Vite dev server).
DB_PORT=5434
API_PORT=8002
WEB_PORT=5175

# ---- Container images (production compose) ----
# Defaults are the public GHCR images published from the GitHub mirror.
# Point these at another registry to run images built elsewhere, or leave them
# blank and run `docker compose build` to build locally at deploy time.
API_IMAGE=
WORKER_IMAGE=

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_DIST=frontend/dist

# ---- Scan tuning ----
SCAN_CONCURRENCY=8
